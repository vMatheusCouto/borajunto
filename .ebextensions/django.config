option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: borajunto.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: borajunto.settings_eb
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput --settings=borajunto.settings_eb"
    leader_only: true
  02_administrador:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py createsuperuser --noinput --settings=borajunto.settings_eb || true"
    leader_only: true
  03_dados_demo:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py popular_demo --settings=borajunto.settings_eb"
    leader_only: true
  04_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput --settings=borajunto.settings_eb"
  05_permissoes_do_banco:
    command: "chown webapp:webapp db.sqlite3 . || true"
