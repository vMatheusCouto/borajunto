<mxfile host="drawio"><diagram name="Modelo lógico" id="modelo-logico"><mxGraphModel dx="2417" dy="1324" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;---\ntitle: Modelo Lógico — BoraJunto\nconfig:\n  layout: elk\n  theme: base\n  themeVariables:\n    fontFamily: \&quot;Helvetica, Arial, sans-serif\&quot;\n    fontSize: \&quot;15px\&quot;\n    primaryColor: \&quot;#EEF3FF\&quot;\n    primaryTextColor: \&quot;#0B1640\&quot;\n    primaryBorderColor: \&quot;#1D5BFF\&quot;\n    lineColor: \&quot;#0B1640\&quot;\n    tertiaryColor: \&quot;#FFFFFF\&quot;\n    attributeBackgroundColorOdd: \&quot;#FFFFFF\&quot;\n    attributeBackgroundColorEven: \&quot;#F4F7FF\&quot;\n    titleColor: \&quot;#0B1640\&quot;\n  er:\n    entityPadding: 18\n---\nerDiagram\n    %% Usuários\n    auth_user ||--o| contas_perfil : \&quot;possui\&quot;\n\n    %% Caronas\n    auth_user ||--o{ caronas_carona : \&quot;oferece\&quot;\n    auth_user ||--o{ caronas_reserva : \&quot;solicita\&quot;\n    caronas_carona ||--o{ caronas_reserva : \&quot;tem\&quot;\n    caronas_carona ||--o{ avaliacoes_avaliacao : \&quot;gera\&quot;\n    auth_user ||--o{ avaliacoes_avaliacao : \&quot;avalia / é avaliado\&quot;\n    caronas_carona |o--o{ notificacoes_notificacao : \&quot;refere-se\&quot;\n    auth_user ||--o{ notificacoes_notificacao : \&quot;recebe\&quot;\n\n    %% Moderação\n    auth_user ||--o{ denuncias_denuncia : \&quot;denuncia / é alvo\&quot;\n    caronas_carona |o--o{ denuncias_denuncia : \&quot;é alvo\&quot;\n    avaliacoes_avaliacao |o--o{ denuncias_denuncia : \&quot;é alvo\&quot;\n    denuncias_denuncia ||--o{ denuncias_decisaomoderacao : \&quot;recebe\&quot;\n    auth_user ||--o{ denuncias_decisaomoderacao : \&quot;decide\&quot;\n\n    auth_user[\&quot;auth_user (Usuário)\&quot;] {\n        integer id PK\n        varchar username UK\n        varchar password\n        varchar first_name\n        varchar last_name\n        varchar email\n        bool is_active\n        bool is_staff\n        bool is_superuser\n        datetime last_login \&quot;nulo\&quot;\n        datetime date_joined\n    }\n\n    contas_perfil[\&quot;contas_perfil (Perfil)\&quot;] {\n        integer id PK\n        integer usuario_id FK, UK\n        varchar matricula UK\n        varchar curso\n        varchar campus\n        varchar foto_url\n        datetime atualizado_em\n    }\n\n    caronas_carona[\&quot;caronas_carona (Carona)\&quot;] {\n        integer id PK\n        integer motorista_id FK\n        varchar origem\n        varchar destino\n        varchar ponto_encontro\n        datetime data_hora\n        smallint vagas \&quot;≥ 0\&quot;\n        text observacoes\n        text motivo_cancelamento\n        varchar status \&quot;publicada · lotada · em_andamento · concluida · cancelada\&quot;\n        datetime criada_em\n    }\n\n    caronas_reserva[\&quot;caronas_reserva (Reserva)\&quot;] {\n        integer id PK\n        bigint carona_id FK\n        integer passageiro_id FK\n        varchar status \&quot;pendente · aceita · recusada · cancelada\&quot;\n        datetime criada_em\n        datetime atualizada_em\n    }\n\n    avaliacoes_avaliacao[\&quot;avaliacoes_avaliacao (Avaliação)\&quot;] {\n        integer id PK\n        bigint carona_id FK\n        integer avaliador_id FK \&quot;≠ avaliado_id\&quot;\n        integer avaliado_id FK\n        smallint nota \&quot;1 a 5\&quot;\n        bool removida\n        datetime criada_em\n        datetime atualizada_em\n    }\n\n    notificacoes_notificacao[\&quot;notificacoes_notificacao (Notificação)\&quot;] {\n        integer id PK\n        integer destinatario_id FK\n        bigint carona_id FK \&quot;nulo\&quot;\n        varchar tipo \&quot;solicitacao · decisao · alteracao · cancelamento · lembrete\&quot;\n        varchar mensagem\n        bool lida\n        datetime criada_em\n    }\n\n    denuncias_denuncia[\&quot;denuncias_denuncia (Denúncia)\&quot;] {\n        integer id PK\n        integer denunciante_id FK\n        integer usuario_id FK \&quot;nulo · alvo\&quot;\n        bigint carona_id FK \&quot;nulo · alvo\&quot;\n        bigint avaliacao_id FK \&quot;nulo · alvo\&quot;\n        varchar motivo \&quot;conduta · ausencia · informacao_falsa · seguranca · outro\&quot;\n        text descricao\n        varchar status \&quot;pendente · procedente · improcedente\&quot;\n        datetime criada_em\n    }\n\n    denuncias_decisaomoderacao[\&quot;denuncias_decisaomoderacao (Decisão)\&quot;] {\n        integer id PK\n        bigint denuncia_id FK\n        integer administrador_id FK\n        varchar resultado \&quot;procedente · improcedente\&quot;\n        varchar acao \&quot;nenhuma · ocultar_conteudo · restringir_conta\&quot;\n        text justificativa \&quot;obrigatória\&quot;\n        datetime decidida_em\n    }\n\n    classDef usuario fill:#E3E7F3,stroke:#0B1640,stroke-width:2px\n    classDef carona fill:#EEF3FF,stroke:#1D5BFF,stroke-width:2px\n    classDef moderacao fill:#FFF1EA,stroke:#FF6A2B,stroke-width:2px\n    class auth_user,contas_perfil usuario\n    class caronas_carona,caronas_reserva,avaliacoes_avaliacao,notificacoes_notificacao carona\n    class denuncias_denuncia,denuncias_decisaomoderacao moderacao\n&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="3U4IYa4aSOE2er3NcUWA-1">
