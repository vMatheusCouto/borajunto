@startuml
' Diagrama de casos de uso do BoraJunto (notação UML 2.5, uml-diagrams.org)
' Associações sem seta; setas só na generalização e nas dependências «include»/«extend».
mainframe uc Casos de Uso do BoraJunto
left to right direction
skinparam shadowing false

actor Estudante
actor Motorista
actor Passageiro
actor Administrador
actor SUAP
actor "Google Maps" as Maps

Motorista --|> Estudante
Passageiro --|> Estudante

rectangle BoraJunto {
  usecase "Autenticar" as UC01
  usecase "Gerenciar perfil" as UC02
  usecase "Consultar notificações" as UC07
  usecase "Consultar histórico\nde caronas" as UC12
  usecase "Registrar denúncia" as UC09
  usecase "Publicar carona" as UC03
  usecase "Calcular rota" as UC13
  usecase "Atualizar carona" as UC06
  usecase "Recalcular rota" as UC14
  usecase "Responder solicitações" as UC11
  usecase "Avaliar participante" as UC08
  usecase "Buscar carona" as UC04
  usecase "Solicitar vaga" as UC05
  usecase "Julgar denúncia" as UC10
  usecase "Administrar avaliações" as UC15
  usecase "Administrar contas" as UC16
}

Estudante -- UC01
Estudante -- UC02
Estudante -- UC07
Estudante -- UC12
Estudante -- UC09
Motorista -- UC03
Motorista -- UC06
Motorista -- UC11
Motorista -- UC08
Passageiro -- UC08
Passageiro -- UC04
Passageiro -- UC05
Administrador -- UC10
Administrador -- UC15
Administrador -- UC16
UC01 -- SUAP
UC13 -- Maps
UC14 -- Maps

UC03 .> UC13 : <<include>>
UC14 .> UC06 : <<extend>>
@enduml
