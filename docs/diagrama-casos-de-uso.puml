@startuml
' Diagrama de casos de uso do BoraJunto (notação UML 2.5, uml-diagrams.org)
' Associações sem seta; setas só na generalização e nas dependências «include»/«extend».
mainframe uc Casos de Uso do BoraJunto
left to right direction
skinparam shadowing false

actor Estudante
actor Motorista
actor Passageiro
actor Administrador
actor SUAP
actor "Google Maps" as Maps

Motorista --|> Estudante
Passageiro --|> Estudante

rectangle BoraJunto {
  usecase "UC01\nAutenticar estudante" as UC01
  usecase "UC02\nGerenciar perfil" as UC02
  usecase "UC07\nConsultar notificações" as UC07
  usecase "UC12\nConsultar histórico\nde caronas" as UC12
  usecase "UC09\nRegistrar denúncia" as UC09
  usecase "UC03\nPublicar carona" as UC03
  usecase "UC13\nCalcular rota" as UC13
  usecase "UC06\nAtualizar carona" as UC06
  usecase "UC14\nRecalcular rota" as UC14
  usecase "UC11\nResponder solicitações" as UC11
  usecase "UC08\nAvaliar participante" as UC08
  usecase "UC04\nBuscar carona" as UC04
  usecase "UC05\nSolicitar vaga" as UC05
  usecase "UC10\nJulgar denúncia" as UC10
  usecase "UC15\nRemover avaliação" as UC15
  usecase "UC16\nSuspender conta" as UC16
}

Estudante -- UC01
Estudante -- UC02
Estudante -- UC07
Estudante -- UC12
Estudante -- UC09
Motorista -- UC03
Motorista -- UC06
Motorista -- UC11
Motorista -- UC08
Passageiro -- UC08
Passageiro -- UC04
Passageiro -- UC05
Administrador -- UC10
UC01 -- SUAP
UC13 -- Maps
UC14 -- Maps

UC03 .> UC13 : <<include>>
UC14 .> UC06 : <<extend>>
UC15 .> UC10 : <<extend>>
UC16 .> UC10 : <<extend>>
@enduml
